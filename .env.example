# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # production: your public HTTPS origin

# ── AI ────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-key

# Optional fallback if Groq fails (outage, rate limit, or a model getting
# deprecated again — this has already happened once mid-project). Leave
# blank to skip the fallback entirely; nothing breaks, Groq failures just
# won't have a backup.
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ── External sources ──────────────────────────────────────────────────────
# No separate key needed — web search runs through Groq's built-in
# "compound" model using GROQ_API_KEY above. Nothing to add here.
